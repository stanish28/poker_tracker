PORT=5001
NODE_ENV=development

# REQUIRED. The server refuses to start without it, so that a missing value can
# never silently fall back to an unauthenticated API. Generate with:
#   openssl rand -hex 32
# On Vercel this must be set in Project -> Settings -> Environment Variables.
# Changing it invalidates every issued token (everyone logs in again).
JWT_SECRET=

# REQUIRED. Postgres connection string. SSL is enabled automatically unless the
# host is localhost/127.0.0.1, so a local Postgres works without extra config:
#   DATABASE_URL=postgres://postgres@127.0.0.1:5432/poker_tracker
DATABASE_URL=

# Optional. Username of the single account allowed to merge duplicate players.
# Must match a users.username value exactly. While unset, merging is disabled
# for everyone and the Merge button stays hidden -- that is the safe default.
# Merging is irreversible: it moves games and settlements onto the kept player,
# deletes the duplicates, and drops settlements between merged players.
ADMIN_USERNAME=

# Email notifications (optional) — uses Nodemailer with Gmail SMTP.
# If EMAIL_USER or EMAIL_PASS is unset, game result emails are skipped (no error).
# On Vercel: add these to Project → Settings → Environment Variables (not REACT_APP_*).
# Apply to Production (and Preview if you test there), then redeploy.
# EMAIL_PASS must be a Gmail App Password, not your account password.
# https://myaccount.google.com/apppasswords
EMAIL_USER=
EMAIL_PASS=
